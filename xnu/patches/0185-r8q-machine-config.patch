From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 1/2] xnu: add initial R8Q ARM64 machine configuration

Add a distinct R8Q machine configuration for the Samsung Galaxy S20 FE 5G
(SM-G781B, Snapdragon 865 / SM8250). Keep SWEET unchanged and do not define
SWEET from the R8Q header: SWEET has board-specific framebuffer and startup
code that must not be enabled on R8Q.

This is a compile/configuration foundation only. GIC security-group handling,
PSCI secondary CPU entry, memory map, framebuffer, and boot-image integration
are intentionally not changed by this patch.
diff --git a/xnu/makedefs/MakeInc.def b/xnu/makedefs/MakeInc.def
--- a/xnu/makedefs/MakeInc.def
+++ b/xnu/makedefs/MakeInc.def
@@ -32,1 +32,1 @@
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET R8Q
@@ -62,3 +62,4 @@
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_R8Q = -DARM64_BOARD_CONFIG_R8Q                    -march=armv8.2-a+crypto
@@ -264,3 +264,3 @@
-ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
+ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET R8Q),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
diff --git a/xnu/pexpert/pexpert/arm64/board_config.h b/xnu/pexpert/pexpert/arm64/board_config.h
--- a/xnu/pexpert/pexpert/arm64/board_config.h
+++ b/xnu/pexpert/pexpert/arm64/board_config.h
@@ -100,5 +100,9 @@
 #ifdef ARM64_BOARD_CONFIG_SWEET
 #include <pexpert/arm64/SWEET.h>
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+#ifdef ARM64_BOARD_CONFIG_R8Q
+#include <pexpert/arm64/R8Q.h>
+#endif /* ARM64_BOARD_CONFIG_R8Q */
 
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
diff --git a/xnu/pexpert/pexpert/arm64/R8Q.h b/xnu/pexpert/pexpert/arm64/R8Q.h
--- /dev/null
+++ b/xnu/pexpert/pexpert/arm64/R8Q.h
@@ -0,0 +1,42 @@
+/*
+ * Initial board configuration for Samsung Galaxy S20 FE 5G (r8q),
+ * SM-G781B, Qualcomm Snapdragon 865 / SM8250 (Kona).
+ *
+ * This is deliberately separate from SWEET. The Snapdragon 865 uses
+ * Kryo 585 CPU cores (Cortex-A77/A55 class), and this initial configuration
+ * selects the common ARMv8.2-A + crypto instruction baseline. Platform
+ * interrupt routing, PSCI secondary startup, and memory layout are not
+ * asserted here; those require R8Q-specific bring-up work.
+ */
+
+#ifndef _PEXPERT_ARM64_R8Q_H
+#define _PEXPERT_ARM64_R8Q_H
+
+#define R8Q                       1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Qualcomm SM8250 platform facts from the R8Q device tree:
+ * eight CPUs, GICv3, 64-byte cache lines, PSCI CPU enable method.
+ * The two CPU clusters are not yet represented as asymmetric scheduler
+ * clusters by this initial XNU configuration.
+ */
+#define R8Q_SMP_MAX_CPUS          8
+
+#endif /* !_PEXPERT_ARM64_R8Q_H */
diff --git a/xnu/osfmk/arm64/proc_reg.h b/xnu/osfmk/arm64/proc_reg.h
--- a/xnu/osfmk/arm64/proc_reg.h
+++ b/xnu/osfmk/arm64/proc_reg.h
@@ -223,2 +223,9 @@
-#elif defined (VMAPPLE)
+#elif defined (R8Q) /* Qualcomm Kryo 585: Cortex-A77/A55 class */
+
+/* I-Cache: 64-byte cache line. */
+#define MMU_I_CLINE 6
+
+/* D-Cache: 64-byte cache line. */
+#define MMU_CLINE   6
+
 #elif defined (VMAPPLE)
